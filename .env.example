# Server-only key; never prefix this with VITE_. Leave empty for local recognition.
GEMINI_API_KEY=""

# Container deployments should set HOST=0.0.0.0. Local development defaults to loopback.
HOST="127.0.0.1"
PORT="3000"

# Optional Ko-fi webhook verification. Empty disables donation verification.
KOFI_VERIFICATION_TOKEN=""

# Supabase Configuration for Cloud Sync & Persistence
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
